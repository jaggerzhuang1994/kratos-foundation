        "hide": 0,
        "skipUrlSync": false,
        "multi": false,
        "includeAll": false,
        "label": "应用 Pod 标签",
        "description": "按目标标签选择 pod_name 或 pod；ACK 常见 pod_name，仓库 ServiceMonitor 示例使用 pod。"
      },
      {
        "name": "operation",
