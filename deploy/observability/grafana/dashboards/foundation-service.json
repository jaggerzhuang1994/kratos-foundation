  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "view",
        "label": "视图",
        "type": "custom",
        "query": "Pod : view_pod,Node : view_node,Instance（Pod IP） : view_instance,Container : view_container",
        "current": {
          "text": "Pod",
          "value": "view_pod"
        },
        "options": [
          {
            "text": "Pod",
            "value": "view_pod",
            "selected": true
          },
          {
            "text": "Node",
            "value": "view_node",
            "selected": false
          },
          {
            "text": "Instance（Pod IP）",
            "value": "view_instance",
            "selected": false
          },
          {
            "text": "Container",
            "value": "view_container",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "namespace",
        "label": "命名空间",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_pod_info, namespace)",
        "query": {
          "query": "label_values(kube_pod_info, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app",
        "label": "应用",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{namespace=~\"${namespace}\",app!=\"\"}, app)",
          "refId": "app"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "description": "稳定的采集端 app 身份。All允许旧指标缺少app标签；选择具体应用要求目标附加该标签。"
      },
      {
        "name": "node",
        "label": "节点",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_node_info, node)",
        "query": {
          "query": "label_values(kube_node_info, node)",
          "refId": "node"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_pod_info{namespace=~\"${namespace}\",node=~\"${node}\"}, pod)",
        "query": {
          "query": "label_values(kube_pod_info{namespace=~\"${namespace}\",node=~\"${node}\"}, pod)",
          "refId": "pod"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "容器",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_pod_container_info{namespace=~\"${namespace}\",pod=~\"${pod}\"}, container)",
        "query": {
          "query": "label_values(kube_pod_container_info{namespace=~\"${namespace}\",pod=~\"${pod}\"}, container)",
          "refId": "container"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app_pod_label",
        "type": "custom",
        "query": "pod_name,pod",
        "current": {
          "text": "pod_name",
          "value": "pod_name"
