{
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "uid": "ack-service-overview",
  "title": "ACK · 服务运行总览",
  "version": 1,
  "tags": [
    "Foundation",
    "diagnostics"
  ],
  "links": [
    {
      "title": "服务总览",
      "type": "link",
      "url": "/d/ack-service-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "容器与节点",
      "type": "link",
      "url": "/d/ack-container-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "应用组件",
      "type": "link",
      "url": "/d/ack-application-components",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "共享资源与健康",
      "type": "link",
      "url": "/d/foundation-shared-resources",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "01 · 服务影响 — 先看流量、错误、延迟与就绪",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "请求速率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((label_replace(rate(server_requests_code_total{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",operation=~\"${operation}\"}[$__rate_interval]), \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"})))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "已进入Foundation方法指标层并完成的请求；当前上报不完整覆盖panic、前置拒绝和所有传输入口。",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "查看应用组件",
              "url": "/d/ack-application-components?${datasource:queryparam}&${namespace:queryparam}&${app:queryparam}&${view:queryparam}&${node:queryparam}&${pod:queryparam}&${container:queryparam}&${app_pod_label:queryparam}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "5xx 比例",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum((label_replace(rate(server_requests_code_total{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",operation=~\"${operation}\",code=~\"5..\"}[$__rate_interval]), \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"})))) or (0 * sum((label_replace(rate(server_requests_code_total{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",operation=~\"${operation}\"}[$__rate_interval]), \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"}))))) / (sum((label_replace(rate(server_requests_code_total{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",operation=~\"${operation}\"}[$__rate_interval]), \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"}))) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "有流量无5xx时补0；无流量或未接入保持空值。不是全部传输层错误率。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "查看应用组件",
              "url": "/d/ack-application-components?${datasource:queryparam}&${namespace:queryparam}&${app:queryparam}&${view:queryparam}&${node:queryparam}&${pod:queryparam}&${container:queryparam}&${app_pod_label:queryparam}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "请求 P95",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) ((label_replace(rate(server_requests_seconds_bucket{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",operation=~\"${operation}\"}[$__rate_interval]), \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"}))))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "先合并所选桶再求分位数；无流量可能为NaN，不能解释为零延迟。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "查看应用组件",
              "url": "/d/ack-application-components?${datasource:queryparam}&${namespace:queryparam}&${app:queryparam}&${view:queryparam}&${node:queryparam}&${pod:queryparam}&${container:queryparam}&${app_pod_label:queryparam}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "已发现应用 Pod 就绪率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (namespace,pod) (kube_pod_status_ready{namespace=~\"${namespace}\",pod=~\"${pod}\",condition=\"true\"}) and on (namespace,pod) (max by (namespace,pod) ((label_replace(up{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",${app_pod_label:raw}!=\"\"}, \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"}))))) / (count(max by (namespace,pod) ((label_replace(up{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",${app_pod_label:raw}!=\"\"}, \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"})))) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "分母为存在抓取目标且可关联到Kubernetes的Pod，不是工作负载期望副本数；控制器期望副本见容器页。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "查看应用组件",
              "url": "/d/ack-application-components?${datasource:queryparam}&${namespace:queryparam}&${app:queryparam}&${view:queryparam}&${node:queryparam}&${pod:queryparam}&${container:queryparam}&${app_pod_label:queryparam}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "已关联抓取目标",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(min by (namespace,app,pod,container,instance,job,node,pod_ip) ((label_replace(up{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",${app_pod_label:raw}!=\"\"}, \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"}))))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "去重后的应用抓取目标须具有所选Pod标签并匹配当前Kubernetes元数据。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "查看应用组件",
              "url": "/d/ack-application-components?${datasource:queryparam}&${namespace:queryparam}&${app:queryparam}&${view:queryparam}&${node:queryparam}&${pod:queryparam}&${container:queryparam}&${app_pod_label:queryparam}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "抓取失败目标",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1 - (min by (namespace,app,pod,container,instance,job,node,pod_ip) ((label_replace(up{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",${app_pod_label:raw}!=\"\"}, \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"})))))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "up=0表示采集失败；仅统计当前范围且拓扑关联成功的目标，缺失发现或标签错误请看下方接入诊断。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "查看应用组件",
              "url": "/d/ack-application-components?${datasource:queryparam}&${namespace:queryparam}&${app:queryparam}&${view:queryparam}&${node:queryparam}&${pod:queryparam}&${container:queryparam}&${app_pod_label:queryparam}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "02 · RED 趋势 — 保留应用身份，按视图下钻",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "title": "请求速率趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (${view:raw},namespace,app) (label_join(label_replace(label_replace(label_join(label_join(((label_replace(rate(server_requests_code_total{namespace=~\"${namespace}\",${app_pod_label:raw}=~\"${pod}\",app=~\"${app}\",container=~\"${container}\",operation=~\"${operation}\"}[$__rate_interval]), \"pod\", \"$1\", \"${app_pod_label:raw}\", \"(.+)\")) * on (namespace,pod) group_left(node,pod_ip) (max by (namespace,pod,node,pod_ip) (kube_pod_info{namespace=~\"${namespace}\",pod=~\"${pod}\",node=~\"${node}\"}))), \"view_pod\", \" / \", \"namespace\", \"pod\"), \"view_container\", \" / \", \"namespace\", \"pod\", \"container\"), \"view_node\", \"$1\", \"node\", \"(.*)\"), \"view_node\", \"未调度\", \"node\", \"^$\"), \"view_instance\", \" / \", \"namespace\", \"pod\", \"pod_ip\"))",
          "legendFormat": "{{namespace}} / {{app}} · {{${view:raw}}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false
          },
          "links": [
            {
              "title": "查看应用组件",
              "url": "/d/ack-application-components?${datasource:queryparam}&${namespace:queryparam}&${app:queryparam}&${view:queryparam}&${node:queryparam}&${pod:queryparam}&${container:queryparam}&${app_pod_label:queryparam}&from=${__from}&to=${__to}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "5xx 比例趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
