      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, max by (env,cluster,kafka_cluster,consumergroup,topic,partition) (kafka_consumergroup_lag{env=~\"${env}\",cluster=~\"${cluster}\",kafka_cluster=~\"${kafka_cluster}\",consumergroup=~\"${consumer_group}\",topic=~\"${broker_topic}\"} >= 0))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "保留真实Kafka集群/消费组/Topic/分区；不按应用Pod归属。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Kafka集群"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "消费组"
            },
