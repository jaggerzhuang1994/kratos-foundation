            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "分区"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lag"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 65
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "环境"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 55
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "采集集群"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Lag",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "kafka_cluster": 0,
              "consumergroup": 1,
              "topic": 2,
              "partition": 3,
              "Value": 4,
              "env": 5,
              "cluster": 6
            },
            "renameByName": {
              "env": "环境",
              "cluster": "采集集群",
              "queue_destination": "逻辑队列",
              "namespace": "命名空间",
              "app": "应用",
              "instance": "探测地址",
              "kafka_cluster": "Kafka集群",
              "consumergroup": "消费组",
              "topic": "Topic",
              "partition": "分区",
              "probe": "探测",
              "Value": "Lag"
            }
          }
        }
      ]
    },
