    {
      "id": 11,
      "title": "Kafka exporter 抓取状态",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (env,cluster,kafka_cluster,instance) (up{foundation_kafka=\"true\",env=~\"${env}\",cluster=~\"${cluster}\",kafka_cluster=~\"${kafka_cluster}\"})",
