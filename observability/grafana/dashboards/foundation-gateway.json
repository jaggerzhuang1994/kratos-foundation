        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "限流（429）比例",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\",code=\"429\"}[$__rate_interval])) or 0 * sum(rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval]))) / (sum(rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
