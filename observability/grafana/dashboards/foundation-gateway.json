    {
      "id": 10,
      "title": "路由 5xx 比例",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\",code=~\"5..\"}[$__rate_interval])) or 0 * sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval]))) / (sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{app}} / {{operation}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "无数据",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "color": "gray",
                  "text": "无数据"
                }
              }
            }
          ],
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
