{
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "version": 1,
  "uid": "foundation-gateway",
  "title": "Foundation · 网关详情",
  "tags": [
    "Foundation",
    "10 服务"
  ],
  "links": [
    {
      "title": "00 平台总览",
