    {
      "id": 8,
      "title": "02 · 按路由 — 哪个路由在报错、变慢或被限流",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "title": "路由诊断（按 5xx 比例排序）",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "(sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\",code=~\"5..\"}[$__rate_interval])) or 0 * sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval]))) / (sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "(sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\",code=\"429\"}[$__rate_interval])) or 0 * sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval]))) / (sum by (namespace,app,operation) (rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (namespace,app,operation,le) (rate(server_requests_seconds_bucket{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "路由即网关 server 指标的 operation；无流量时比例与分位数为空。",
      "fieldConfig": {
        "defaults": {
          "noValue": "无入口流量",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          },
          {
            "matcher": {
              "id": "byType",
              "options": "string"
            },
            "properties": [
              {
                "id": "noValue",
