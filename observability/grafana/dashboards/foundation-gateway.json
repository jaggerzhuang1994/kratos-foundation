              "operation": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6
            },
            "renameByName": {
              "namespace": "命名空间",
              "app": "网关",
              "operation": "路由",
              "Value #A": "RPS",
