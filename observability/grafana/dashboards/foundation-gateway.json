  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "命名空间",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(client_requests_code_total, namespace)",
        "query": {
          "query": "label_values(client_requests_code_total, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "app",
        "label": "网关应用",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(client_requests_code_total{namespace=~\"${namespace}\"}, app)",
        "query": {
          "query": "label_values(client_requests_code_total{namespace=~\"${namespace}\"}, app)",
          "refId": "gateway"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "description": "有下游调用的应用，一次看一个网关；入口指标只统计所选应用，避免把普通服务的流量算进网关。服务详情页的应用会直接带入。"
      },
      {
        "name": "route",
        "label": "路由",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\"}, operation)",
        "query": {
          "query": "label_values(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\"}, operation)",
          "refId": "route"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "client_operation",
        "label": "下游接口",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(client_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\"}, operation)",
        "query": {
          "query": "label_values(client_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\"}, operation)",
          "refId": "client_operation"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "01 · 入口与下游概况",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "入口 RPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "无入口流量",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "入口 5xx 比例",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\",code=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval]))) / (sum(rate(server_requests_code_total{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "无入口流量",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "入口 P99",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(server_requests_seconds_bucket{namespace=~\"${namespace}\",app=~\"${app}\",operation=~\"${route}\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "无入口流量",
