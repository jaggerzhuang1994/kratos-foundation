{
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "uid": "foundation-shared-resources",
  "title": "Foundation · 健康探测",
  "version": 1,
  "tags": [
    "Foundation",
    "30 基础设施"
  ],
  "links": [
    {
      "title": "00 平台总览",
      "type": "link",
      "url": "/d/foundation-fleet-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "10 服务详情",
      "type": "link",
