      "title": "30 容器与节点",
      "type": "link",
      "url": "/d/ack-container-overview",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "30 健康探测",
      "type": "link",
      "url": "/d/foundation-shared-resources",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 12,
      "title": "01 · 实际 HTTP 健康探测 — readiness / liveness / 采集",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 13,
      "title": "readyz / healthz 实际探测状态",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (env,cluster,app,instance,probe) (probe_success{foundation_probe=\"true\",env=~\"${env}\",cluster=~\"${cluster}\",app=~\"${probe_app}\"})",
          "legendFormat": "{{env}} / {{cluster}} · {{app}} / {{instance}} / {{probe}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "probe_success与up分别表示实际HTTP探测结果和探测结果能否采集；二者不能互相替代。未配置目标留空，不伪造成功。",
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "失败",
                  "color": "red"
                },
                "1": {
                  "text": "成功",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 14,
      "title": "探测器抓取状态",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (env,cluster,app,instance,probe) (up{foundation_probe=\"true\",env=~\"${env}\",cluster=~\"${cluster}\",app=~\"${probe_app}\"})",
          "legendFormat": "{{env}} / {{cluster}} · {{app}} / {{instance}} / {{probe}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "probe_success与up分别表示实际HTTP探测结果和探测结果能否采集；二者不能互相替代。未配置目标留空，不伪造成功。",
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "失败",
                  "color": "red"
                },
                "1": {
                  "text": "成功",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 15,
      "title": "实际 HTTP 状态码",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (env,cluster,app,instance,probe) (probe_http_status_code{foundation_probe=\"true\",env=~\"${env}\",cluster=~\"${cluster}\",app=~\"${probe_app}\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "description": "仅成功200符合当前blackbox模块；0可能代表没有收到HTTP响应。接口返回503与探测器不可达须结合up判断。",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP状态码"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "探测"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 65
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "应用"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 65
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "探测地址"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 215
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "环境"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 55
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "采集集群"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "Value": 0,
              "probe": 1,
              "app": 2,
              "instance": 3,
              "env": 4,
              "cluster": 5
            },
            "renameByName": {
              "env": "环境",
              "cluster": "采集集群",
              "queue_destination": "逻辑队列",
              "namespace": "命名空间",
              "app": "应用",
              "instance": "探测地址",
              "kafka_cluster": "Kafka集群",
              "consumergroup": "消费组",
              "topic": "Topic",
              "partition": "分区",
              "probe": "探测",
              "Value": "HTTP状态码"
            }
          }
        }
      ]
    },
    {
      "id": 16,
      "title": "HTTP 探测耗时",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (env,cluster,app,instance,probe) (probe_duration_seconds{foundation_probe=\"true\",env=~\"${env}\",cluster=~\"${cluster}\",app=~\"${probe_app}\"})",
          "legendFormat": "{{env}} / {{cluster}} · {{app}} / {{instance}} / {{probe}}",
          "instant": false,
          "range": true
        }
      ],
      "description": "一次探测包含连接与响应处理；并非业务方法P95。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "title": "共享资源口径与接入",
      "type": "text",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 4
      },
      "targets": [],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未接入 / 无样本",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**健康探测** 需blackbox目标带 `foundation_probe=true` 和 `probe`，分别请求readyz/healthz。空白表示未接入、无样本或目标缺失，不能解释为健康。此页不受应用页的Node/Pod筛选影响。\n\nQueue 库存与 Kafka Lag 已迁到“队列与 Kafka 详情”。"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "env",
        "label": "环境",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{foundation_probe=\"true\"}, env)",
          "refId": "env"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "cluster",
        "label": "采集集群",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{foundation_probe=\"true\",env=~\"${env}\"}, cluster)",
          "refId": "cluster"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "probe_app",
        "label": "探测应用",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{foundation_probe=\"true\",env=~\"${env}\",cluster=~\"${cluster}\"}, app)",
          "refId": "probe_app"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "description": "Queue共享Store、Kafka位点和HTTP健康探测；不按业务Pod/Node归属，不需要Kubernetes元数据。"
}
