    },
    {
      "title": "10 网关",
      "type": "link",
      "url": "/d/foundation-gateway",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "10 应用组件",
      "type": "link",
      "url": "/d/ack-application-components",
      "includeVars": true,
